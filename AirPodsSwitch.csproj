<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ProGlide</AssemblyName>
    <ApplicationIcon>Assets\PodGlide.ico</ApplicationIcon>
    <Product>ProGlide</Product>
  </PropertyGroup>
  <ItemGroup><Compile Remove="BuildSupport\**\*.cs" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Assets\*.png;Assets\*.jpg;Assets\*.ico;Assets\*.txt"><LogicalName>ProGlide.Assets.%(Filename)%(Extension)</LogicalName></EmbeddedResource></ItemGroup>
  <ItemGroup>
    <Reference Include="System.Runtime" />
    <Reference Include="System.Runtime.WindowsRuntime"><HintPath>$(WINDIR)\Microsoft.NET\Framework64\v4.0.30319\System.Runtime.WindowsRuntime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Runtime.InteropServices.WindowsRuntime"><HintPath>$(WINDIR)\Microsoft.NET\Framework64\v4.0.30319\System.Runtime.InteropServices.WindowsRuntime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Windows.Foundation"><HintPath>$(WINDIR)\System32\WinMetadata\Windows.Foundation.winmd</HintPath><Private>false</Private></Reference>
    <Reference Include="Windows.Devices"><HintPath>$(WINDIR)\System32\WinMetadata\Windows.Devices.winmd</HintPath><Private>false</Private></Reference>
    <Reference Include="Windows.Storage"><HintPath>$(WINDIR)\System32\WinMetadata\Windows.Storage.winmd</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
